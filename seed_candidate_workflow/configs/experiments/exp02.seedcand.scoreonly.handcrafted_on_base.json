{
  "experiment": {
    "scoring_run_id": "run_seedcand_handcrafted_scoreonly",
    "graph_id": "bundle_seedcand",
    "mode": "score_only",
    "graph_family": "seed_candidate"
  },
  "artifacts": {
    "graph_bundle_root": "seed_candidate_workflow/output/graph_bundles",
    "scoring_output_root": "seed_candidate_workflow/output/scoring_runs"
  },
  "setup": {
    "enable": {
      "anchor": false,
      "seed": false,
      "candidate": false,
      "seed_candidate": false,
      "pair_training": false
    },
    "policy": {
      "on_missing": "fail",
      "on_present": "reuse"
    },
    "paths": {
      "anchor_config": "seed_candidate_workflow/configs/anchor_graph.default.json",
      "seed_config": "seed_candidate_workflow/configs/anchor_seed.default.json",
      "candidate_config": "seed_candidate_workflow/configs/anchor_candidate_generation.default.json",
      "pair_training": {
        "graph_meta_json": "core/graph/output/incidents-lake-misp-large_hetero.meta.json"
      }
    }
  },
  "selection": {
    "score_targets": [
      "seed_candidate"
    ],
    "gt_set": "default_multi_gt",
    "gt_sets_path": "seed_candidate_workflow/configs/experiments/gt_sets.json"
  },
  "scoring": {
    "score_mode": "seed_candidate_handcrafted_v1",
    "params": {
      "handcrafted": {
        "w_semantic": 0.42,
        "w_rare_artifact": 0.28,
        "w_twohop": 0.22,
        "w_component": 0.08,
        "component_scale": 0.12,
        "w_multi_source": 0.08,
        "w_time_penalty": 0.1,
        "seed_weight_floor": 0.88,
        "seed_weight_base": 0.92,
        "seed_evidence_rarity_scale": 0.08,
        "use_seed_evidence_rarity": true
      },
      "pu": {}
    }
  },
  "community": {
    "base_config": "seed_candidate_workflow/configs/anchor_community.default.json",
    "sweep": {
      "methods": [
        "louvain",
        "leiden"
      ],
      "weight_thresholds": [
        0.0,
        0.1,
        0.2,
        0.3
      ],
      "resolutions": [
        1.0,
        1.5,
        2.0
      ],
      "use_edge_weights_in_partitioning": true,
      "sort_by": "v-measure"
    }
  }
}
