{
  "run": {
    "graph_id": "main_gnn_semantic_sn_example"
  },
  "inputs": {
    "graph_pt": "core/graph/output/REPLACE_STEM_hetero.pt",
    "meta_json": "core/graph/output/REPLACE_STEM_hetero.meta.json",
    "to_undirected": true,
    "embeddings_json": "core/graph/output/semantic_supernode_embeddings_overlay/embeddings.json",
    "embedding_source": "cache_or_compute",
    "prefer_translated_for_compute": false,
    "tfidf_max_features": 4096,
    "popular_domains_path": "core/feature_set_extraction/caches/popular_domains.txt",
    "web_hosting_domains_path": "core/feature_set_extraction/caches/web_hosting_domains.txt"
  },
  "node_fields": {
    "include_text_fields": true,
    "graph_node_columns": [
      "ts",
      "url_set",
      "sender_set",
      "attachment_set",
      "sender_email_domain_set",
      "domain_set",
      "stem_set"
    ]
  },
  "filters": {
    "filter_popular_domains": true,
    "filter_web_hosting_domains": false
  },
  "_comment": "Point graph_pt/meta_json to the hetero files emitted when semantic_supernode is built. embeddings_json MUST be the semantic_supernode_embeddings_overlay/embeddings.json next to graph output (mean BERT per graph_external_id), not the global per-email cache, so anchor semantic cosine matches supernodes."
}
