{
  "experiment": {
    "scoring_run_id": "run_shard_unweighted",
    "graph_id": "bundle_shard",
    "mode": "setup_and_score",
    "graph_family": "semantic_shard"
  },
  "artifacts": {
    "graph_bundle_root": "analysis/output/graph_bundles",
    "scoring_output_root": "analysis/output/scoring_runs"
  },
  "setup": {
    "enable": {
      "anchor": false,
      "seed": false,
      "candidate": false,
      "seed_candidate": false,
      "pair_training": false,
      "semantic_shard": true
    },
    "policy": {
      "on_missing": "build",
      "on_present": "reuse"
    },
    "paths": {
      "anchor_config": "analysis/configs/anchor_graph.default.json",
      "seed_config": "analysis/configs/anchor_seed.default.json",
      "candidate_config": "analysis/configs/anchor_candidate_generation.default.json",
      "pair_training": {
        "graph_meta_json": "core/graph/output/incidents-lake-misp-large_hetero.meta.json"
      },
      "semantic_shard": {
        "embeddings_json": "core/utils/embeddings/output/embeddings.json",
        "graph_pt": "core/graph/output/incidents-lake-misp-large_hetero.pt",
        "meta_json": "core/graph/output/incidents-lake-misp-large_hetero.meta.json",
        "to_undirected": true,
        "step1": {
          "min_cluster_size": 2,
          "min_samples": null,
          "fallback_cosine_distance_threshold": 0.22,
          "noise_as_singleton": true
        },
        "step2": {
          "semantic_top_k": 20,
          "semantic_min_cos": 0.95,
          "show_progress": false,
          "include_routing_channels_in_graph": false,
          "infra_channel_switches": {
            "url": { "enabled": true, "candidate": true, "scoring": true, "routing": false },
            "sender_email_domain": { "enabled": true, "candidate": true, "scoring": true, "routing": false },
            "domain": { "enabled": true, "candidate": true, "scoring": true, "routing": false },
            "stem": { "enabled": true, "candidate": true, "scoring": true, "routing": false },
            "sender": { "enabled": true, "candidate": true, "scoring": true, "routing": false },
            "attachment": { "enabled": true, "candidate": true, "scoring": true, "routing": false },
            "html_structure_fingerprint": { "enabled": false, "candidate": true, "scoring": true, "routing": false },
            "origin_ip": { "enabled": false, "candidate": true, "scoring": true, "routing": true },
            "helo_host": { "enabled": false, "candidate": true, "scoring": true, "routing": true },
            "return_path_email": { "enabled": false, "candidate": true, "scoring": true, "routing": true },
            "return_path_domain": { "enabled": false, "candidate": true, "scoring": true, "routing": true }
          }
        }
      }
    }
  },
  "selection": {
    "score_targets": [
      "semantic_shard"
    ],
    "gt_set": "default_multi_gt",
    "gt_sets_path": "analysis/configs/experiments/gt_sets.json"
  },
  "scoring": {
    "score_mode": "none",
    "params": {
      "semantic_shard": {}
    }
  },
  "community": {
    "base_config": "analysis/configs/anchor_community.default.json",
    "sweep": {
      "methods": [
        "leiden"
      ],
      "weight_thresholds": [
        0.0,
        0.25,
        0.5
      ],
      "resolutions": [
        0.6,
        0.8,
        1.0,
        1.2,
        1.5,
        2.0,
        2.5,
        3.0
      ],
      "use_edge_weights_in_partitioning": false,
      "sort_by": "v_measure"
    }
  }
}
