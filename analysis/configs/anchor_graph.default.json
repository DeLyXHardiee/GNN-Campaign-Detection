{
  "run": {
    "graph_id": "local_default"
  },
  "inputs": {
    "graph_pt": "core/graph/output/incidents-lake-misp-large_hetero.pt",
    "meta_json": "core/graph/output/incidents-lake-misp-large_hetero.meta.json",
    "to_undirected": true,
    "embeddings_json": "core/utils/embeddings/output/embeddings.json",
    "embedding_source": "cache_or_compute",
    "prefer_translated_for_compute": true,
    "tfidf_max_features": 4096,
    "popular_domains_path": "core/feature_set_extraction/caches/popular_domains.txt",
    "web_hosting_domains_path": "core/feature_set_extraction/caches/web_hosting_domains.txt"
  },
  "node_fields": {
    "include_text_fields": true,
    "graph_node_columns": [
      "ts",
      "url_set",
      "sender_set",
      "attachment_set",
      "sender_email_domain_set",
      "domain_set",
      "stem_set"
    ]
  },
  "filters": {
    "filter_popular_domains": true,
    "filter_web_hosting_domains": false
  },
  "channels": {
    "channel_settings": {
      "semantic": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "top_k": 7500,
        "min_cos": 0.9
      },
      "url": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "idf_exponent": 1.0,
        "idf_scale": 1.0,
        "max_email_df": 2500
      },
      "sender": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "idf_exponent": 1.0,
        "idf_scale": 1.0,
        "max_email_df": 2000
      },
      "attachment": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "idf_exponent": 1.0,
        "idf_scale": 1.0,
        "max_email_df": 1500
      },
      "sender_email_domain": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "idf_exponent": 1.0,
        "idf_scale": 1.0,
        "max_email_df": 3500
      },
      "domain": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "idf_exponent": 1.0,
        "idf_scale": 1.0,
        "max_email_df": 3000
      },
      "stem": {
        "edge_create_enabled": true,
        "evidence_enabled": true,
        "score_enabled": true,
        "idf_exponent": 1.0,
        "idf_scale": 1.0,
        "max_email_df": 3000
      },
      "html_structure_fingerprint": {
        "edge_create_enabled": false,
        "evidence_enabled": false,
        "score_enabled": false
      },
      "return_path_email": {
        "edge_create_enabled": false,
        "evidence_enabled": false,
        "score_enabled": false
      },
      "return_path_domain": {
        "edge_create_enabled": false,
        "evidence_enabled": false,
        "score_enabled": false
      },
      "helo_host": {
        "edge_create_enabled": false,
        "evidence_enabled": false,
        "score_enabled": false
      },
      "origin_ip": {
        "edge_create_enabled": false,
        "evidence_enabled": false,
        "score_enabled": false
      },
      "received_host": {
        "edge_create_enabled": false,
        "evidence_enabled": false,
        "score_enabled": false
      }
    }
  },
  "candidate_generation": {
    "max_pairs_per_artifact": 10000
  },
  "persistence": {
    "write_candidates": true,
    "write_serialized_graph": true
  }
}
